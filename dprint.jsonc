{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  // OHPM packages ship oh-package.json5 as plain JSON, which jq reads in the
  // scripts. Oxc would rewrite it in JSON5's style.
  "excludes": [
    "**/oh-package.json5",
    // The documentation site's packages and what its build generates.
    "docs/node_modules",
    "docs/dist",
    "docs/.astro",
    "docs/public/api",
    "docs/src/generated",
    "docs/pnpm-lock.yaml",
  ],
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "exec": {
    "commands": [
      {
        // The documentation site's pages.
        "command": "pnpm --dir docs exec mdxlint --rc-path .mdxlintrc.json --file-path {{file_path}}",
        "exts": ["mdx"],
        "cacheKeyFiles": ["docs/pnpm-lock.yaml"],
      },
    ],
  },
  "plugins": [
    "npm:@dprint/oxc@0.49.0",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3",
    // The documentation site's Astro components.
    "npm:dprint-plugin-markup@0.27.6@2bc0cd38720ff3ce4418a7b1566e161c2193fbecf1969d61d77f09c4dfef5171",
  ],
}
