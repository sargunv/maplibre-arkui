{
  "name": "@maplibre/arkui",
  "version": "0.1.0-preview.1",
  "description": "ArkUI components for MapLibre Native maps on HarmonyOS and OpenHarmony: a map with gestures, its camera, markers, the user's location, map content as data, and snapshots.",
  "keywords": ["maplibre", "map", "maps", "vector tiles", "gis", "arkui", "arkts", "harmonyos", "openharmony"],
  "main": "Index.ets",
  "author": { "name": "MapLibre", "url": "https://maplibre.org" },
  "homepage": "https://github.com/sargunv/maplibre-arkui#readme",
  "repository": "https://github.com/sargunv/maplibre-arkui",
  "bugs": { "url": "https://github.com/sargunv/maplibre-arkui/issues" },
  "compatibleSdkType": "OpenHarmony",
  "compatibleSdkVersion": 20,
  "obfuscated": false,
  "dependencies": {
    "@maplibre/native-ffi": "file:../build/ffi/native-ffi.har"
  }
}
