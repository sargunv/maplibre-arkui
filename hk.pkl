// hk runs the checks for pre-commit, `mise run check`, and `mise run fix`.
//
// No formatter or linter outside the OpenHarmony SDK understands ArkTS (.ets),
// so dprint leaves those files alone. ets-loader applies the ArkTS rules when
// the build tasks compile them.

amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

steps {
  ["dprint"] = Builtins.dprint
  ["jactionlint"] = Builtins.jactionlint
  ["shellcheck"] = Builtins.shellcheck
  // The READMEs' ArkTS examples are in the demo, whose build compiles them.
  ["doc-examples"] {
    glob = List("README.md", "library/README.md", "demo/entry/src/main/ets/docs/*.ets")
    check = "scripts/check-doc-examples.sh README.md library/README.md"
  }
  // The rules of the API guidelines' Organization section that a script can
  // check.
  ["api-layout"] {
    glob = List("library/Index.ets", "library/src/main/ets/**", "docs/scripts/categories.mjs")
    check = "scripts/check-api-layout.sh"
  }
}
